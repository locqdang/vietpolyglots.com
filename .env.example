# Shared defaults / production-safe values
STRAPI_URL=https://strapi.vietpolyglots.com
STRAPI_API_TOKEN=
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_URI=
MONGO_DB=nextjs_db
MONGO_HARO_DB=haro
NODE_ENV=development
JWT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://vietpolyglots.com/api/auth/google/callback
GOOGLE_MAILBOX_CALLBACK_URL=https://vietpolyglots.com/api/haro/mailbox/google/callback
N8N_LOGIN_WEBHOOK_URL=
NEXT_PUBLIC_FRONTEND_URL=https://vietpolyglots.com

# GPU gate (Chroma text-to-image) base URL. The gate fronts ComfyUI and owns the GPU lease.
# Bound on the LAN, so use its LAN address (not localhost). Server-only; never exposed to the browser.
GPU_GATE_URL=http://192.168.0.62:8189

# Image Generate default size (used when the user picks no size). Integers 256-2048, multiples of 8.
IMAGE_GEN_DEFAULT_WIDTH=1024
IMAGE_GEN_DEFAULT_HEIGHT=1024

# Image Generate default negative prompt (pre-filled in the form; user can change or clear it).
IMAGE_GEN_DEFAULT_NEGATIVE=blurry, low quality, distorted, deformed, watermark, text, bad anatomy

# Redis for the image generation job queue and per-user rate limiting. Server-only.
# DB 1 is dedicated to image-gen so it never collides with existing Redis data.
REDIS_URL=redis://192.168.0.62:6379/1

# Maximum generations per authenticated user in each fixed window.
IMAGE_GEN_RATE_LIMIT_MAX=15
IMAGE_GEN_RATE_LIMIT_WINDOW_SECONDS=3600

# Completed images/history are retained for this many days.
IMAGE_GEN_RETENTION_DAYS=30

LOG_LEVEL=info
LOG_HASH_SALT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Local debug overrides belong in .env.local, for example:
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:33345
# GOOGLE_CALLBACK_URL=http://localhost:33345/api/auth/google/callback
# GOOGLE_MAILBOX_CALLBACK_URL=http://localhost:33345/api/haro/mailbox/google/callback
# LOG_LEVEL=debug
